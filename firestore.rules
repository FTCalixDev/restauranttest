rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'calixdsth@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints
    function isValidOrderRecord(data) {
      return data.keys().hasAll(['orderNumber', 'orderType', 'status', 'total', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['orderNumber', 'orderType', 'status', 'total', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.orderNumber is string && data.orderNumber.size() >= 2 && data.orderNumber.size() <= 20 && data.orderNumber.matches('^#[0-9]{3,10}$') &&
        data.orderType is string && data.orderType.size() >= 5 && data.orderType.size() <= 15 && data.orderType in ['delivery', 'table', 'takeaway'] &&
        data.status is string && data.status.size() >= 4 && data.status.size() <= 20 && data.status in ['received', 'kitchen', 'oven', 'ready', 'in_transit', 'delivered', 'cancelled', 'fraud_alert'] &&
        data.total is number && data.total >= 0 && data.total <= 1000000 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSyncAuditLog(data) {
      return data.keys().hasAll(['action', 'targetId', 'ownerId', 'createdAt']) &&
        data.keys().hasOnly(['action', 'targetId', 'ownerId', 'createdAt']) &&
        data.action is string && data.action.size() >= 3 && data.action.size() <= 80 &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp;
    }

    // 4. Collection Rules: /orders/{orderId}
    match /orders/{orderId} {
      allow get: if isVerifiedUser() && isValidId(orderId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidOrderRecord(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidOrderRecord(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            existing().ownerId == request.auth.uid &&
            !(existing().status in ['delivered', 'cancelled']) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(orderId);
    }

    // 5. Collection Rules: /sync_logs/{logId}
    match /sync_logs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidSyncAuditLog(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin() && isValidId(logId);
    }
  }
}
